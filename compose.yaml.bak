services:

  web:
    image: nginx
    restart: unless-stopped
    container_name: web_apti_compose
    ports:
      - "8081:80"
    volumes:
      - ./web:/usr/share/nginx/html
    networks:
      - red_apti_compose

  db:
    image: mysql:8
    restart: unless-stopped
    container_name: db_apti_compose
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
      MYSQL_DATABASE: ${MYSQL_DATABASE}
    volumes:
      - datos_apti_compose:/var/lib/mysql
    networks:
      - red_apti_compose

  adminer:
    image: adminer:latest
    restart: unless-stopped
    container_name: adminer_apti
    ports:
      - "8082:8080"
    environment:
      ADMINER_DEFAULT_SERVER: db
    depends_on:
      - db
    networks:
      - red_apti_compose
  portainer:
    image: portainer/portainer-ce:latest
    restart: unless-stopped
    container_name: portainer_apti
    ports:
      - "9000:9000"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer_data:/data
    networks:
      - red_apti_compose

networks:
  red_apti_compose:

volumes:
  datos_apti_compose:
  portainer_data:
